[Unit]
Description=Lares - Household Guardian AI
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=jason
WorkingDirectory=/Users/jaxcoder/strix-jax/Lares-Jax
Environment=PATH=/Users/jaxcoder/strix-jax/Lares-Jax/.venv/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/docker start letta
ExecStartPre=/bin/sleep 10
ExecStart=/Users/jaxcoder/strix-jax/Lares-Jax/.venv/bin/python /Users/jaxcoder/strix-jax/Lares-Jax/run.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
