[Unit]
Description=Lares MCP Server - Discord I/O and Tool Provider
After=network.target

[Service]
Type=simple
User=jason
WorkingDirectory=/Users/jaxcoder/strix-jax/Lares-Jax
EnvironmentFile=/Users/jaxcoder/strix-jax/Lares-Jax/.env
Environment=PATH=/Users/jaxcoder/strix-jax/Lares-Jax/.venv/bin:/usr/bin:/bin
ExecStart=/Users/jaxcoder/strix-jax/Lares-Jax/.venv/bin/python -m lares.mcp_server
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
