[Unit]
Description=Lares AI Assistant - Core Brain
After=network.target lares-mcp.service
Requires=lares-mcp.service

[Service]
Type=simple
User=jason
WorkingDirectory=/Users/jaxcoder/strix-jax/Lares-Jax
EnvironmentFile=/Users/jaxcoder/strix-jax/Lares-Jax/.env
Environment=PATH=/Users/jaxcoder/strix-jax/Lares-Jax/.venv/bin:/usr/bin:/bin
ExecStart=/Users/jaxcoder/strix-jax/Lares-Jax/.venv/bin/python -m lares.main_mcp
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
