[Unit]
Description=Lares AI Assistant - Legacy (run.py with built-in Discord)
After=network.target

[Service]
Type=simple
User=jason
WorkingDirectory=/Users/jaxcoder/strix-jax/Lares-Jax
EnvironmentFile=/Users/jaxcoder/strix-jax/Lares-Jax/.env
Environment=PATH=/Users/jaxcoder/strix-jax/Lares-Jax/.venv/bin:/usr/bin:/bin
ExecStart=/Users/jaxcoder/strix-jax/Lares-Jax/.venv/bin/python run.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
