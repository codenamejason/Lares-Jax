[Unit]
Description=Lares MCP Server - Tool Provider with Approval Queue
After=network.target
Before=lares.service

[Service]
Type=simple
User=jason
WorkingDirectory=/Users/jaxcoder/strix-jax/Lares-Jax
Environment=PATH=/Users/jaxcoder/strix-jax/Lares-Jax/.venv/bin:/usr/bin:/bin
ExecStart=/Users/jaxcoder/strix-jax/Lares-Jax/.venv/bin/python -m lares.mcp_server
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
